<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LogisticTrackingApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LogisticTrackingApp"
    xmlns:views="clr-namespace:LogisticTrackingApp.Views"
    Title="LogisticTrackingApp">

    <Shell.ToolbarItems>
        <ToolbarItem x:Name="ThemeToggleButton"
                     Text="🌙"
                     Clicked="OnThemeToggleClicked"
                     Priority="1"/>
    </Shell.ToolbarItems>
    
    <ShellContent
        Title="Logistics Tracking"
        ContentTemplate="{DataTemplate views:ShipmentTracking}"
        Route="ShipmentTracking" />

</Shell>

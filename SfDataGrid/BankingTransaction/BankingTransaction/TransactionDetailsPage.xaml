<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BankingTransaction.ViewModels"
             x:Class="BankingTransaction.TransactionDetailsPage"
             x:DataType="viewmodels:TransactionDetailsViewModel"
             Title="Transaction Details"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <Border Style="{StaticResource SurfaceCardStyle}" Padding="20" Margin="20">
            <StackLayout Spacing="16">
                <!-- Header Section with Icon, Description, and Amount -->
                <StackLayout Orientation="Horizontal" Spacing="12">
                    <Border BackgroundColor="{StaticResource AccentSoft}" Stroke="Transparent" HeightRequest="72" WidthRequest="72" VerticalOptions="Center">
                        <Label Text="🏦" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Center" Spacing="4">
                        <Label Text="{Binding SelectedTransaction.Description}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}" LineBreakMode="WordWrap" />
                        <Label Text="{Binding SelectedTransaction.TransactionId}" FontSize="12" TextColor="{StaticResource SecondaryText}" />
                    </StackLayout>

                    <StackLayout VerticalOptions="Center" Spacing="8" HorizontalOptions="End">
                        <Label Text="{Binding SelectedTransaction.AmountDisplay}" Style="{StaticResource BalanceValueStyle}" HorizontalOptions="End" />
                        <Frame BackgroundColor="{StaticResource AccentSoft}" CornerRadius="12" Padding="6" HasShadow="False" HorizontalOptions="End">
                            <Label Text="{Binding SelectedTransaction.Status}" TextColor="{StaticResource AccentColor}" FontSize="12" />
                        </Frame>
                    </StackLayout>
                </StackLayout>

                <!-- Transaction Details Grid -->
                <Grid ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0 -->
                    <StackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                        <Label Text="Transaction ID" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding SelectedTransaction.TransactionId}" Style="{StaticResource FieldValueStyle}" />
                    </StackLayout>

                    <StackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                        <Label Text="Date" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding SelectedTransaction.FormattedDate}" Style="{StaticResource FieldValueStyle}" />
                    </StackLayout>

                    <!-- Row 1 -->
                    <StackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                        <Label Text="From Account" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding SelectedTransaction.FromAccount}" Style="{StaticResource FieldValueStyle}" LineBreakMode="WordWrap" />
                    </StackLayout>

                    <StackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                        <Label Text="To Account" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding SelectedTransaction.ToAccount}" Style="{StaticResource FieldValueStyle}" LineBreakMode="WordWrap" />
                    </StackLayout>

                    <!-- Row 2 -->
                    <StackLayout Grid.Row="2" Grid.Column="0" Spacing="2">
                        <Label Text="Amount" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding SelectedTransaction.AmountDisplay}" Style="{StaticResource FieldValueAccentStyle}" />
                    </StackLayout>

                    <StackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                        <Label Text="Fee" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding SelectedTransaction.FeeDisplay}" Style="{StaticResource FieldValueStyle}" />
                    </StackLayout>

                    <!-- Row 3 -->
                    <StackLayout Grid.Row="3" Grid.Column="0" Spacing="2">
                        <Label Text="Status" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding SelectedTransaction.Status}" Style="{StaticResource FieldValueStyle}" />
                    </StackLayout>

                    <StackLayout Grid.Row="3" Grid.Column="1" Spacing="2">
                        <Label Text="Notes" Style="{StaticResource FieldLabelStyle}" />
                        <Label Text="{Binding SelectedTransaction.Notes}" Style="{StaticResource FieldValueStyle}" LineBreakMode="WordWrap" />
                    </StackLayout>
                </Grid>

                <!-- Action Buttons -->
                <HorizontalStackLayout Spacing="12">
                    <Button Text="Report Issue" BackgroundColor="{StaticResource AccentColor}" TextColor="White" CornerRadius="8" />
                    <Button Text="Download Receipt" BackgroundColor="{StaticResource AccentColor}" TextColor="White" CornerRadius="8" />
                </HorizontalStackLayout>
            </StackLayout>
        </Border>
    </ScrollView>

</ContentPage>
